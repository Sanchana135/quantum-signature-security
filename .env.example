# Application Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=generate-a-strong-random-key-in-production-use-secrets-token-hex
DATABASE_URL=sqlite:///quantum_sig_sec.db

# Security Settings
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_HOURS=2

# Quantum-Inspired Anomaly Settings
ANOMALY_SENSITIVITY=0.75
BURST_WINDOW_MINUTES=10
BURST_THRESHOLD=4
